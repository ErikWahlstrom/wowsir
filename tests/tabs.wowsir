# popups and new tabs are followed; closing returns to the opener
open localhost:8765/tabs.html
click "button:Open popup"
expect title Popup
click button:Approve
expect title Tabs
expect text "popup said: signed in"
click "link:Open misc in new tab"
expect url misc.html
tab 0
expect title Tabs
tab 1
expect url misc.html
tab close
expect title Tabs
